<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Icono AniCal"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/widget_header_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.05"
            android:text="ANICAL • ESTRENOS DE HOY"
            android:textColor="#A5A3C2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Actualizar widget"
            android:padding="2dp"
            android:src="@android:drawable/ic_menu_rotate" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#2E2B52" />

    <!-- List of anime premiering today -->
    <TextView
        android:id="@+id/widget_anime_list_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="top"
        android:maxLines="5"
        android:text="• Cargando estrenos..."
        android:textColor="#F1F1F8"
        android:textSize="12sp" />

</LinearLayout>
